PORT=3001

# Un ou plusieurs endpoints RPC separes par des virgules (fallback dans l'ordre).
# Remplacer par des endpoints Helius/QuickNode pour la prod - le RPC public
# est rate-limite et pas fiable pour un service qui scale.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com

# Duree de vie du cache des infos mint, en millisecondes.
CACHE_TTL_MS=30000

# Rate limiting de l'API (par IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Chemin du fichier SQLite pour l'historique des scans (defaut: ./scan_history.db)
# DB_PATH=./scan_history.db

# Cles API valides, separees par des virgules. Si vide/absent, l'API reste
# ouverte (pratique en dev local) - a definir pour activer l'auth en prod.
# API_KEYS=cle-secrete-1,cle-secrete-2

# --- Bot X (poste un scan de token tendance toutes les heures, voir
# src/bot/postTrendingScan.ts et le cron dans deploy/) ---

# Cle API Birdeye (gratuite sur https://birdeye.so/developers) pour la
# liste des tokens Solana tendance.
# BIRDEYE_API_KEY=

# Identifiants de l'app X (developer.x.com, acces "Read and Write").
# X_APP_KEY=
# X_APP_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# true = log le tweet au lieu de le poster (pour tester sans credentials X).
# BOT_DRY_RUN=true

# --- Stream RTMP vers pump.fun (voir deploy/stream.sh) ---
# URL + cle fournies par le bouton "Start livestream" (mode RTMP) sur la
# page du token cree sur pump.fun.
# RTMP_URL=rtmp://.../live/<cle>
